# Copy this file to ".env" and paste your YouTube Data API v3 key.
# Get a free key: https://console.cloud.google.com/
#   1. Create a project  2. Enable "YouTube Data API v3"
#   3. Credentials -> Create credentials -> API key
YOUTUBE_API_KEY=

# OpenAI key for the "Curriculum -> Learning Path" feature.
# Get one: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

PORT=8787
